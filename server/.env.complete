# Complete Environment Configuration Template
# Copy this to .env and fill in your actual values

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jd-transcripts?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random-at-least-32-characters
JWT_EXPIRE=7d

# Email Configuration (Choose one)
# Gmail Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=admin@jdlegaltranscripts.com
EMAIL_PASS=your-app-specific-password
ADMIN_EMAIL=admin@jdlegaltranscripts.com

# SendGrid Configuration (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@jdlegaltranscripts.com

# Frontend Configuration
FRONTEND_URL=https://sensational-tartufo-6888eb.netlify.app
CORS_ORIGIN=https://sensational-tartufo-6888eb.netlify.app

# Server Configuration
PORT=5000
NODE_ENV=production

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_PATH=./uploads

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-different-from-jwt

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Notification Configuration
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Payment Configuration (if needed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloud Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=jd-transcripts-files
AWS_REGION=us-east-1

# Additional Security
HELMET_ENABLED=true
TRUST_PROXY=true

# Development Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Database Pool Configuration
DB_POOL_SIZE=10
DB_TIMEOUT=30000

# Redis Configuration (for caching/sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-external-services

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_COMPRESSION=true
ENABLE_AUTO_BACKUP=true

# Performance Configuration
COMPRESSION_ENABLED=true
CACHE_TTL=3600

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# External API Keys
OPENAI_API_KEY=your-openai-api-key-if-using-ai-features
TWILIO_ACCOUNT_SID=your-twilio-sid-for-sms
TWILIO_AUTH_TOKEN=your-twilio-token