# JD Reporting Company Production Server Configuration

# Server Settings
PORT=$PORT
NODE_ENV=production
FRONTEND_URL=https://jd-reporting-company.netlify.app

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-change-this-immediately
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# Email Configuration (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=your-production-gmail-app-password
ADMIN_EMAIL=admin@jdreporting.org

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Database (SQLite - for Railway)
# Database file: ./database/jd_reporting.db

# Supabase (Optional - for additional features)
SUPABASE_URL=https://your-production-project-ref.supabase.co
SUPABASE_ANON_KEY=your-production-supabase-anon-key

# Security
SESSION_SECRET=your-production-session-secret-here

# Railway specific
RAILWAY_STATIC_URL=
RAILWAY_ENVIRONMENT=production