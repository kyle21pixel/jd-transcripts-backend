# Complete Frontend Environment Configuration Template
# Copy this to .env and fill in your actual values

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_URL_PRODUCTION=https://your-backend-url.com/api

# App Configuration
REACT_APP_APP_NAME=JD Legal Transcripts
REACT_APP_APP_VERSION=1.0.0
REACT_APP_COMPANY_NAME=JD Reporting Company

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ADMIN_DASHBOARD=true
REACT_APP_ENABLE_FILE_UPLOAD=true
REACT_APP_ENABLE_REAL_TIME_UPDATES=true

# External Services
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=104857600
REACT_APP_ALLOWED_FILE_TYPES=audio/*,.mp3,.wav,.m4a,.aac,.ogg
REACT_APP_MAX_FILES_PER_ORDER=10

# UI Configuration
REACT_APP_THEME=default
REACT_APP_PRIMARY_COLOR=#2563eb
REACT_APP_SECONDARY_COLOR=#64748b

# Development Configuration
REACT_APP_DEBUG_MODE=false
REACT_APP_SHOW_DEV_TOOLS=false

# API Timeouts
REACT_APP_API_TIMEOUT=30000
REACT_APP_UPLOAD_TIMEOUT=300000

# Caching Configuration
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_TTL=300000

# Error Reporting
REACT_APP_SENTRY_DSN=your-sentry-dsn-for-error-tracking
REACT_APP_ERROR_REPORTING_ENABLED=true

# Social Media Links
REACT_APP_FACEBOOK_URL=https://facebook.com/jdreporting
REACT_APP_TWITTER_URL=https://twitter.com/jdreporting
REACT_APP_LINKEDIN_URL=https://linkedin.com/company/jdreporting

# Contact Information
REACT_APP_CONTACT_EMAIL=info@jdlegaltranscripts.com
REACT_APP_CONTACT_PHONE=+1-555-123-4567
REACT_APP_SUPPORT_EMAIL=support@jdlegaltranscripts.com

# Business Information
REACT_APP_BUSINESS_ADDRESS=123 Business St, City, State 12345
REACT_APP_BUSINESS_HOURS=Monday-Friday 9AM-5PM EST

# Legal Information
REACT_APP_PRIVACY_POLICY_URL=/privacy-policy
REACT_APP_TERMS_OF_SERVICE_URL=/terms-of-service

# Notification Configuration
REACT_APP_NOTIFICATION_DURATION=5000
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=false

# Performance Configuration
REACT_APP_LAZY_LOADING_ENABLED=true
REACT_APP_IMAGE_OPTIMIZATION=true

# Security Configuration
REACT_APP_ENABLE_CSP=true
REACT_APP_SECURE_COOKIES=true

# Localization
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_SUPPORTED_LANGUAGES=en,es,fr

# Build Configuration
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# PWA Configuration
REACT_APP_PWA_ENABLED=true
REACT_APP_PWA_THEME_COLOR=#2563eb
REACT_APP_PWA_BACKGROUND_COLOR=#ffffff

# Testing Configuration
REACT_APP_ENABLE_TESTING_FEATURES=false
REACT_APP_MOCK_API_ENABLED=false

# Third-party Integrations
REACT_APP_INTERCOM_APP_ID=your-intercom-app-id
REACT_APP_HOTJAR_ID=your-hotjar-id
REACT_APP_MIXPANEL_TOKEN=your-mixpanel-token

# CDN Configuration
REACT_APP_CDN_URL=https://cdn.jdlegaltranscripts.com
REACT_APP_ASSETS_URL=https://assets.jdlegaltranscripts.com

# WebSocket Configuration
REACT_APP_WS_URL=wss://your-websocket-url.com
REACT_APP_WS_ENABLED=true

# Map Configuration (if using maps)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
REACT_APP_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Video/Audio Configuration
REACT_APP_ENABLE_AUDIO_PREVIEW=true
REACT_APP_AUDIO_PLAYER_THEME=modern

# Accessibility Configuration
REACT_APP_HIGH_CONTRAST_MODE=false
REACT_APP_SCREEN_READER_SUPPORT=true

# Development URLs
REACT_APP_DEV_API_URL=http://localhost:5000/api
REACT_APP_STAGING_API_URL=https://staging-api.jdlegaltranscripts.com/api